#!/usr/bin/env bash
# ============================================================================
# run_system - convenience wrapper around the controller's native process
# management (the same code path Windows uses).
#
#   ./run_system start    # build (if needed) + start peers A, B, C
#   ./run_system stop     # stop all peers
#   ./run_system status   # show RUNNING / STOPPED per peer
# ============================================================================
set -u
cd "$(dirname "$0")"
mkdir -p run

if [ ! -x build/controller ] || [ ! -x build/peer ]; then
    echo "build/controller not found - building with CMake..."
    cmake -S . -B build && cmake --build build -j || exit 1
fi

case "${1:-}" in
    start)  exec ./build/controller sys start ;;
    stop)   exec ./build/controller sys stop ;;
    status) exec ./build/controller sys status ;;
    *)      echo "usage: $0 start|stop|status" ; exit 1 ;;
esac
